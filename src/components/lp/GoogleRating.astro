---
/**
 * Google-betyget som socialt bevis — G-märket, stjärnorna, snittet och antalet.
 *
 * MEDVETET INTE EN LÄNK. Sidans enda klickbara element är CTA-knapparna och
 * formuläret, så en utlänk härifrån vore ett sätt att lämna tratten utan att
 * konvertera. Ren Astro — noll JavaScript.
 *
 * Klienten bekräftade 2026-09-09 att det sammanlagda antalet omdömen på
 * Google och Facebook är över 25, och begärde 2026-09-10 att badgen visar fem
 * gyllene stjärnor tillsammans med den siffran.
 */

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
/** Bekräftat kombinerat antal på Google och Facebook. */
const COMBINED_REVIEW_COUNT = 25;

const STAR_PATH =
  "M12 .587l3.668 7.431 8.2 1.192-5.934 5.787 1.401 8.169L12 18.896l-7.335 3.863 1.401-8.169L.132 9.21l8.2-1.192z";
---

{/*
  ALDRIG två rader. Två saker gör det:

  1. `container-type: inline-size` på wrappern gör den till en query-container,
     och badgens font-size sätts i `cqi` — 1 % av den TILLGÄNGLIGA bredden.
     Storleken följer alltså den faktiska kolumnen, inte viewporten.
  2. Allt inuti mäts i `em` (ikon, stjärnor, mellanrum, padding) och raden är
     `whitespace-nowrap`, så hela elementet skalar proportionerligt som EN rad.

  Ändrar du texten: mät om på 320 px, bryt aldrig raden.
*/}
<div class="w-full" style="container-type: inline-size">
  <div
    class:list={[
      "inline-flex max-w-full items-center gap-[0.45em] whitespace-nowrap rounded-full border border-white/10 bg-black/25 px-[0.95em] py-[0.5em] leading-none",
      className,
    ]}
    style="font-size: clamp(0.625rem, 3.95cqi, 0.875rem)"
  >
    <svg viewBox="0 0 48 48" class="size-[1.35em] shrink-0" aria-hidden="true">
      <path
        fill="#EA4335"
        d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
      ></path>
      <path
        fill="#4285F4"
        d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
      ></path>
      <path
        fill="#FBBC05"
        d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
      ></path>
      <path
        fill="#34A853"
        d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
      ></path>
    </svg>

    <span
      class="inline-flex shrink-0 items-center gap-[0.06em]"
      role="img"
      aria-label="5 av 5 stjärnor"
    >
      {
        Array.from({ length: 5 }).map(() => (
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="size-[1.05em]"
            fill="#FBBC04"
          >
            <path d={STAR_PATH} />
          </svg>
        ))
      }
    </span>

    <span class="text-white/70">
      +{COMBINED_REVIEW_COUNT} omdömen på Google &amp; Facebook
    </span>
  </div>
</div>
