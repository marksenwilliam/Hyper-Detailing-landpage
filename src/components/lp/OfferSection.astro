---
/**
 * Erbjudandesektionen — H2 som sammanfattar tjänsten, prisbanner i accentfärg,
 * och punkter som beskriver RESULTAT för kunden (processen bor i "Så går det
 * till" längre ned).
 *
 * Sektionens bärande bild är den lösa dörren i sprutboxen. Den sitter direkt
 * under prisbannern med flit: bannern säger "per detalj", bilden visar vad en
 * detalj är. Tillsammans gör de enheten omöjlig att missförstå, vilket är den
 * enda invändning erbjudandet realistiskt möter.
 *
 * Copyn håller sig inom claim-reglerna i src/data/packages.ts: ingen hållbarhet
 * i år eller månader för lackeringen, inga garantiord, och varje pris bär
 * "från" + enheten.
 *
 * Ingen gåv-rad här. Mallen hade en "på köpet"-punkt värd 800 kr;
 * LACKERING_BONUS är null för Hyper, och punkten renderas därför bara om en
 * riktig gåva någon gång fylls i.
 */
import GoogleRating from "@/components/lp/GoogleRating.astro";
import { GALLERI, IMAGES } from "@/data/images";
import { LACKERING, LACKERING_BONUS, isHalfPrice } from "@/data/packages";
import { formatKr } from "@/lib/utils";

const BULLETS = [
  "Kulören blandas efter bilens färgkod — inte en ungefärlig nyans",
  "Klarlack som ger djup och glans åt den lackerade ytan",
  "En detalj i taget — du betalar bara för den du vill åtgärda",
  "Fast pris innan vi börjar, efter att vi sett skadan",
  // "klart samma dag" och liknande löften finns inte i klientens material —
  // lova ingen ledtid förrän Hyper bekräftat en.
  "Lämna in bilen som den är — vi tar hand om resten",
];

const doorImage = IMAGES.sprutlackering;
---

<section class="py-12 md:py-16 lg:py-20">
  <div class="container max-w-3xl">
    {/* Sociala beviset först — omdömena läses innan erbjudandet, inte efter. */}
    <div class="text-center">
      <GoogleRating />
    </div>

    <h2 class="mt-6 text-center text-balance text-white">
      <span
        class="block text-3xl leading-none font-black tracking-tight uppercase sm:text-4xl md:text-5xl"
      >
        {LACKERING.name}
      </span>
      <span
        class="mt-3 block text-xl leading-tight font-bold tracking-tight text-white/85 md:text-2xl"
      >
        Halva priset per detalj — så länge kampanjen gäller
      </span>
    </h2>

    {/* Prisbannern i accentfärg. Samma siffror som CTA-knappen (samma källa:
        LACKERING), så de kan aldrig säga olika. Enheten står på nu-priset,
        ankaret utskrivet i klartext under. */}
    <div class="bg-primary text-primary-foreground mt-7 rounded-2xl px-5 py-4 md:px-7 md:py-5">
      <p class="text-xl leading-tight font-bold md:text-3xl">
        Just nu från {formatKr(LACKERING.price)} {LACKERING.unit}
      </p>
      <p class="mt-1 text-base leading-tight font-semibold opacity-80 md:text-lg">
        <span class="whitespace-nowrap">
          (ordinarie pris från <span class="line-through"
            >{formatKr(LACKERING.originalPrice)}</span
          >)
        </span>
      </p>
      <p class="mt-1.5 text-sm leading-relaxed font-medium opacity-90 md:text-[15px]">
        {LACKERING.tagline}
        {isHalfPrice(LACKERING) && " Under kampanjen betalar du halva ordinarie priset."}
      </p>
    </div>

    {/* Bilden som förklarar enheten: EN avmonterad dörr, ensam i boxen. */}
    <figure class="mt-6">
      <img
        src={doorImage.src}
        alt={doorImage.alt}
        width={doorImage.width}
        height={doorImage.height}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full rounded-2xl object-cover ring-1 ring-white/10"
      />
      <figcaption class="text-muted-foreground mt-2.5 text-[13px] leading-relaxed">
        Så ser "per detalj" ut i praktiken: detaljen lackeras för sig, i bilens
        egen kulör.
      </figcaption>
    </figure>

    <ul class="mt-7 space-y-3.5">
      {
        BULLETS.map((bullet) => (
          <li class="flex items-start gap-3 text-[15px] leading-snug text-white/85 md:text-base">
            <span
              aria-hidden="true"
              class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-3"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </span>
            {bullet}
          </li>
        ))
      }
      {/* Renderas bara om Hyper faktiskt lägger till en gåva (LACKERING_BONUS
          är null i dag) — en påhittad gåva är ett påhittat värde. */}
      {
        LACKERING_BONUS && (
          <li class="flex items-start gap-3 text-[15px] leading-snug text-white/85 md:text-base">
            <span
              aria-hidden="true"
              class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-xs"
            >
              🎁
            </span>
            {LACKERING_BONUS.name} på köpet — värde {formatKr(LACKERING_BONUS.value)}
          </li>
        )
      }
    </ul>

    <p class="font-display mt-8 text-lg font-bold text-white md:text-xl">
      Bilen är en investering — var rädd om den.
    </p>

    {/* Fyra lackeringsmoment. 2×2 på telefon, en rad om fyra från md.
        width/height matchar exporten så raden inte hoppar när bilderna laddar.

        ⚠️ Bilderna är GENERERADE (se src/data/images.ts). Bildtexten under sa
        tidigare "Bilar ur vår egen verkstad i Umeå" — den gällde de riktiga
        kundfotona som låg här innan och vore osann nu. Den nya texten beskriver
        vad bilderna visar utan att påstå vems bilar det är. Skärp den inte
        förrän riktiga foton är på plats. */}
    <div class="mt-8 grid grid-cols-2 gap-3 md:mt-10 md:grid-cols-4 md:gap-4">
      {
        GALLERI.map((photo) => (
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-2xl object-cover ring-1 ring-white/10"
          />
        ))
      }
    </div>
    <p class="text-muted-foreground mt-3 text-[12px] leading-relaxed">
      Exempel på hur ett lackeringsjobb går till: maskering, detaljen lackerad
      för sig, och den färdiga ytan.
    </p>
  </div>
</section>
