---
import SectionCard from "@/components/section-card.astro";
import { BUSINESS } from "@/data/business";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Sidan hittades inte | Hyper Detailing"
  description="Sidan du letade efter finns inte."
  noindex
  hideNav
  hideFloatingCall
>
  <div class="space-y-3 px-3 py-3 md:space-y-4 md:px-4 md:py-4 lg:px-6 lg:py-6">
    <SectionCard>
      <section
        class="flex min-h-[80svh] flex-col items-center justify-center px-6 py-24 text-center"
      >
        <p class="text-primary font-mono text-sm font-bold tracking-wider">
          404
        </p>
        <h1 class="mt-4 text-3xl font-bold text-balance md:text-5xl">
          Den här sidan finns inte
        </h1>
        <p class="text-muted-foreground mt-5 max-w-md leading-relaxed">
          Länken kan vara gammal eller feltryckt. Gå tillbaka till startsidan för
          att se aktuella erbjudanden — eller ring oss så hjälper vi dig direkt.
        </p>
        <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
          <a
            href="/"
            class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-12 items-center rounded-full px-8 text-base font-semibold transition-colors"
          >
            Till startsidan
          </a>
          <a
            href={BUSINESS.phone.href}
            class="inline-flex h-12 items-center rounded-full border border-white/20 px-8 text-base font-semibold transition-colors hover:bg-white/5"
          >
            Ring {BUSINESS.phone.display}
          </a>
        </div>
      </section>
    </SectionCard>
  </div>
</DefaultLayout>
